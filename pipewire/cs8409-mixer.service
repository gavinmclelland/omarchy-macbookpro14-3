[Unit]
Description=CS8409 mixer: PCM 0 dB, internal mic unmuted
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
Type=oneshot
# Keep ALSA PCM at 0 dB; PipeWire/OSD is the only volume fader.
# PCM at 25% (-38 dB) under a 23% sink made speakers thin and quiet.
ExecStart=/usr/bin/amixer -q -c PCH set PCM 100%
ExecStart=/usr/bin/amixer -q -c PCH set "Internal Mic" cap unmute 100%
ExecStart=/usr/bin/amixer -q -c PCH set "Internal Mic Boost" 100%
ExecStart=/usr/bin/wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
# Hardware 4ch sink must stay at 0 dB. App volume lives on cs8409_speakers only.
ExecStart=/usr/bin/pactl set-sink-volume alsa_output.pci-0000_00_1f.3.analog-surround-40 100%

[Install]
WantedBy=default.target

