[Unit]
Description=CS8409 mixer: internal mic unmuted
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire.service
PartOf=pipewire.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Do not force PCM or analog-surround-40 to 100%. Omarchy volume keys
# (Touch Bar) resolve through cs8409_speakers to that physical sink.
ExecStart=/usr/bin/amixer -q -c PCH set "Internal Mic" cap unmute 100%
ExecStart=/usr/bin/amixer -q -c PCH set "Internal Mic Boost" 100%
ExecStart=/usr/bin/wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0
ExecStart=/usr/bin/pactl set-sink-volume cs8409_speakers 100%

[Install]
WantedBy=default.target
