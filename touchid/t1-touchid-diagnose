#!/usr/bin/env python3
"""Diagnose access to the T1 SEP KernelRelay USB interface.

This is not an authenticator and must not be installed in PAM. It locates
iBridge 05ac:8600 config-2 interface 7 (KernelRelayHost), which is neither a
libfprint reader nor the T2 BridgeXPC transport.

Usage:
  t1-touchid-diagnose --describe   # parse sysfs descriptors, no USB I/O
  t1-touchid-diagnose --probe      # read the SEP bulk pair (needs config 2)
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from t1_relay import (
    SepPipe,
    current_config,
    load_sep_from_sysfs,
    verify_transport,
)
from t1_usb import find_sep_interface, sep_in_config


def cmd_describe(desc: Path) -> int:
    raw = desc.read_bytes()
    live = Path("/sys/bus/usb/devices/1-3/descriptors")
    # Do not touch live iBridge sysfs when describing a fixture; a wedged
    # usb_set_configuration makes bConfigurationValue reads hang in D-state.
    cfg = None
    try:
        if desc.resolve() == live.resolve():
            cfg = current_config()
    except OSError:
        cfg = None
    sep = find_sep_interface(raw)
    print(f"iBridge 05ac:8600 live_config={cfg}")
    print(
        f"SEP KernelRelay config={sep.config} iface={sep.interface} "
        f"out=0x{sep.ep_out:02x} in=0x{sep.ep_in:02x}"
    )
    print(f"sep_in_config1={sep_in_config(raw, 1)} sep_in_config2={sep_in_config(raw, 2)}")
    if cfg != sep.config:
        print(
            f"SEP interface is not active (need USB config {sep.config}, have {cfg})",
            file=sys.stderr,
        )
        return 2
    return 0


def cmd_probe() -> int:
    cfg = current_config()
    sep = load_sep_from_sysfs()
    how = verify_transport(cfg, sep)
    print(f"live_config={cfg} need_config={sep.config} transport={how}")
    if how == "unavailable":
        print(
            "KernelRelay is unavailable in the active USB configuration; refusing USB I/O",
            file=sys.stderr,
        )
        return 2
    with SepPipe(sep) as pipe:
        got = pipe.configuration()
        print(f"libusb_config={got} claimed_iface={sep.interface}")
        # Kick the IN pipe once so we know the bulk pair is alive.
        first = pipe.bulk_in(timeout_ms=250)
        print(f"bulk_in_0={len(first)} bytes {first[:16].hex() if first else ''}")
        print("transport-probe-ok (not an authentication result)")
        return 0


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__)
    action = p.add_mutually_exclusive_group(required=True)
    action.add_argument("--describe", action="store_true")
    action.add_argument("--probe", action="store_true")
    p.add_argument(
        "--descriptors",
        type=Path,
        default=Path("/sys/bus/usb/devices/1-3/descriptors"),
        help="USB descriptors blob (default: live iBridge sysfs)",
    )
    args = p.parse_args()
    if args.describe:
        return cmd_describe(args.descriptors)
    return cmd_probe()


if __name__ == "__main__":
    raise SystemExit(main())
